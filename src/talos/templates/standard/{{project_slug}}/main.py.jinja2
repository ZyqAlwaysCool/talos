Description: 服务启动入口
Generated by: Talos
"""

from __future__ import annotations

import uvicorn
from fastapi import FastAPI

from core.config.config_center import get_app_config
from core.exceptions import global_exception_handler
from core.logging import setup_logger
from core.middleware import RequestTraceMiddleware


def create_app() -> FastAPI:
    config = get_app_config()
    setup_logger()

    from core.task.worker import load_task_modules
    load_task_modules()

    from app.api import api_router
    app = FastAPI(title="{{ project_name }}")
    app.add_middleware(RequestTraceMiddleware)
    app.include_router(api_router)

    {% if auth_enabled %}
    from core.auth.auth_router import auth_router, set_auth_service
    from core.auth.auth_service import AuthService
    from core.auth.user_storage import AuthUserStorage
    from core.storage.mongo_storage import MongoStorage

    if config.auth_enabled:
        if not config.auth_secret_key:
            from core.config.config_center import ConfigValidationError
            raise ConfigValidationError(
                "TALOS_AUTH_SECRET_KEY is required when TALOS_AUTH_ENABLED is true."
            )
        auth_service = AuthService(
            config.auth_secret_key, config.auth_token_expire_hours
        )
        auth_storage = AuthUserStorage(
            MongoStorage(
                db_name=config.mongo_db_name, collection_name="auth_users"
            )
        )
        auth_service.set_user_storage(auth_storage)
        app.state.auth_service = auth_service
        set_auth_service(auth_service)
        app.include_router(auth_router)
    {% endif %}

    app.add_exception_handler(Exception, global_exception_handler)
    return app


app = create_app()


if __name__ == "__main__":
    config = get_app_config()
    uvicorn.run(
        app,
        host=config.server_host,
        port=config.server_port,
        log_level=config.log_level.lower(),
        reload=False,
    )
