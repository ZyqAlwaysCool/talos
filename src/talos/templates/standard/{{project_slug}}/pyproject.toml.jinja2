[project]
name = "{{ project_slug }}"
version = "0.1.0"
description = "{{ project_name }} - AI Agent 项目 (由 Talos 生成)"
readme = "README.md"
requires-python = ">=3.10"
dependencies = [
    "fastapi>=0.128.0",
    "httpx>=0.28.0",
    "loguru>=0.7.0",
    "motor>=3.7.0",
    "pocketflow>=0.0.3",
    "pydantic-ai-slim[openai]>=1.56.0",
    "pydantic>=2.0.0",
    "pymongo>=4.16.0",
    "python-dotenv>=1.2.0",
    "redis>=5.3.0",
    "uvicorn>=0.30.0",
]

[dependency-groups]
dev = [
    "pytest>=9.0.0",
    "pytest-asyncio>=1.0.0",
    "pyright>=1.1.0",
    "ruff>=0.15.0",
]

[tool.ruff]
target-version = "py310"

[tool.ruff.lint]
select = ["E", "F", "I", "N", "UP"]

[tool.pyright]
pythonVersion = "3.10"
typeCheckingMode = "basic"
include = ["core", "agents", "main.py", "worker_main.py"]
exclude = ["tests", ".venv", "data", "logs"]
reportMissingTypeStubs = "none"
