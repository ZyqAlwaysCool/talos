# ── Talos Agent 项目环境变量 ──

# Logging
TALOS_LOG_LEVEL=INFO
TALOS_LOG_DIR=logs

# Server
TALOS_SVR_HOST=0.0.0.0
TALOS_SVR_PORT={{ server_port }}

# MongoDB
TALOS_MONGO_HOST=127.0.0.1
TALOS_MONGO_PORT=27017
TALOS_MONGO_DATABASE={{ mongo_db_name }}

# Redis
TALOS_REDIS_MODE=standalone
TALOS_REDIS_HOST=127.0.0.1
TALOS_REDIS_PORT=6379
TALOS_REDIS_DB=2
TALOS_REDIS_PASSWORD=

# Multi-queue: worker_group:queue_name (comma-separated)
TALOS_QUEUE_NAMES=default:{{ redis_queue_prefix }}:queue

# Worker
TALOS_WORKER_QUEUE_NAME={{ redis_queue_prefix }}:queue
TALOS_WORKER_MAX_JOBS=10
TALOS_WORKER_JOB_TIMEOUT=3600
TALOS_WORKER_KEEP_RESULT=86400
TALOS_WORKER_RETRY_JOBS=true
TALOS_WORKER_MAX_TRIES=3

# LLM
TALOS_LLM_PROVIDER={{ llm_provider }}
TALOS_LLM_BASE_URL=
TALOS_LLM_API_KEY=
TALOS_LLM_MODEL={% if llm_provider == 'anthropic' %}claude-sonnet-4-6{% else %}gpt-4o{% endif %}
TALOS_LLM_TEMPERATURE=0.2
TALOS_LLM_MAX_TOKENS=1024
TALOS_LLM_TIMEOUT=60
TALOS_LLM_OUTPUT_RETRIES=1

# Task modules (comma-separated Python module paths)
TALOS_TASK_MODULES=agents.text_processor.workflow.task_entry

{% if auth_enabled %}
# Auth
TALOS_AUTH_ENABLED=true
TALOS_AUTH_SECRET_KEY=change-me-in-production
TALOS_AUTH_TOKEN_EXPIRE_HOURS=24
{% else %}
# Auth (disabled)
TALOS_AUTH_ENABLED=false
{% endif %}

# Thinking stream
TALOS_THINKING_STREAM_ENABLED=false
TALOS_THINKING_CHANNEL_PREFIX=agents:thinking

# File write
TALOS_ENABLE_FILE_WRITE=false
